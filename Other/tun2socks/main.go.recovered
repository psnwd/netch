// The C# side (Netch/Interops/tun2socks.cs, enum NameList) passes these as the first tun_dial argument.
const (
	TYPE_BYPBIND = iota // 0  local address that outgoing sockets bind to
	TYPE_BYPLIST        // 1  file with bypass CIDRs, one per line, or "disabled"
	TYPE_DNSADDR        // 2  "tls://host:port" or "host:port"
	TYPE_ADAPMTU        // 3
	TYPE_TCPREST        // 4  starts a new TCP ServerInfo
	TYPE_TCPTYPE        // 5
	TYPE_TCPHOST
	TYPE_TCPUSER
	TYPE_TCPPASS
	TYPE_TCPMETH
	TYPE_TCPPROT
	TYPE_TCPPRPA
	TYPE_TCPOBFS
	TYPE_TCPOBPA
	TYPE_UDPREST // 14 starts a new UDP ServerInfo
	TYPE_UDPTYPE
	TYPE_UDPHOST
	TYPE_UDPUSER
	TYPE_UDPPASS
	TYPE_UDPMETH
	TYPE_UDPPROT
	TYPE_UDPPRPA
	TYPE_UDPOBFS
	TYPE_UDPOBPA
)

var (
	bypassBind string
	bypassList string
	dnsAddr    string
	dnsNet     string // "tcp" or "tcp-tls"; consumed by package adns (not recovered yet)
	mtu        int

	tcpInfo, udpInfo *structs.ServerInfo

	device tun.Device
	stack  core.LWIPStack
	ranger cidranger.Ranger

	tcpHandler core.TCPConnHandler
	udpHandler core.UDPConnHandler

	running bool

	upLock, dlLock sync.Mutex
	up, dl         uint64
)

//export tun_dial
func tun_dial(name C.int, value *C.char) C.bool { // main.go:73
	switch name {
	case TYPE_BYPBIND:
		bypassBind = C.GoString(value)
	case TYPE_BYPLIST:
		bypassList = C.GoString(value)
	case TYPE_DNSADDR:
		s := C.GoString(value)
		if parts := strings.SplitN(s, "://", 2); len(parts) == 2 {
			dnsAddr = parts[1]
			if parts[0] == "tls" {
				dnsNet = "tcp-tls"
			} else {
				dnsNet = "tcp"
			}
		} else {
			dnsAddr = s
		}
	case TYPE_ADAPMTU:
		n, err := strconv.Atoi(C.GoString(value))
		if err != nil {
			panic(err)
		}
		mtu = n
	case TYPE_TCPREST:
		tcpInfo = new(structs.ServerInfo)
	case TYPE_TCPTYPE:
		tcpInfo.Type = C.GoString(value)
	case TYPE_TCPHOST:
		tcpInfo.Hostname = C.GoString(value)
	case TYPE_TCPUSER:
		tcpInfo.Username = C.GoString(value)
	case TYPE_TCPPASS:
		tcpInfo.Password = C.GoString(value)
	case TYPE_TCPMETH:
		tcpInfo.Method = C.GoString(value)
	case TYPE_TCPPROT:
		tcpInfo.Prot = C.GoString(value)
	case TYPE_TCPPRPA:
		tcpInfo.ProtParam = C.GoString(value)
	case TYPE_TCPOBFS:
		tcpInfo.OBFS = C.GoString(value)
	case TYPE_TCPOBPA:
		tcpInfo.OBFSParam = C.GoString(value)
	case TYPE_UDPREST:
		udpInfo = new(structs.ServerInfo)
	case TYPE_UDPTYPE:
		udpInfo.Type = C.GoString(value)
	case TYPE_UDPHOST:
		udpInfo.Hostname = C.GoString(value)
	case TYPE_UDPUSER:
		udpInfo.Username = C.GoString(value)
	case TYPE_UDPPASS:
		udpInfo.Password = C.GoString(value)
	case TYPE_UDPMETH:
		udpInfo.Method = C.GoString(value)
	case TYPE_UDPPROT:
		udpInfo.Prot = C.GoString(value)
	case TYPE_UDPPRPA:
		udpInfo.ProtParam = C.GoString(value)
	case TYPE_UDPOBFS:
		udpInfo.OBFS = C.GoString(value)
	case TYPE_UDPOBPA:
		udpInfo.OBFSParam = C.GoString(value)
	default:
		return false
	}

	return true
}

//export tun_init
func tun_init() C.bool { // main.go:145
	up, dl = 0, 0

	if !newRanger() {
		return false
	}

	guid, err := windows.GUIDFromString("{14EA48E9-69FA-409F-8752-22563978E802}")
	if err != nil {
		log.Printf("[tun2socks][newTUN][windows.GUIDFromString] %v", err)
		return false
	}

	device, err = tun.CreateTUNWithRequestedGUID("aioCloud", &guid, mtu)
	if err != nil {
		log.Printf("[tun2socks][newTUN][tun.CreateTUN] %v", err)
		return false
	}

	binder := &net.TCPAddr{IP: net.ParseIP(bypassBind)}

	// only SOCKS5 is wired up in this build
	switch tcpInfo.Type {
	case "S5", "Socks", "Socks5":
		tcpHandler = &proxies.TCPHandler{H: &socks.TCPHandler{T: tcpInfo}, Binder: binder, Ranger: ranger}
	}

	switch udpInfo.Type {
	case "S5", "Socks", "Socks5":
		udpHandler = &proxies.UDPHandler{H: &socks.UDPHandler{T: udpInfo, Conns: map[core.UDPConn]*socks.Conn{}}, Binder: bypassBind, Ranger: ranger}
	}

	if tcpHandler == nil || udpHandler == nil {
		log.Printf("[tun2socks][proxies.NewHandler] Unknown Type")
		return false
	}

	stack = core.NewLWIPStack()
	core.RegisterOutputFn(func(data []byte) (int, error) { // main.go:173 (tun_init.func1): lwIP -> device
		if !running {
			return len(data), nil
		}

		dlLock.Lock()
		dl += uint64(len(data))
		dlLock.Unlock()

		return device.Write(data, 0)
	})
	core.RegisterTCPConnHandler(tcpHandler)
	core.RegisterUDPConnHandler(udpHandler)

	running = true

	go func() { // main.go:189 (tun_init.func2): device -> lwIP
		buf := make([]byte, mtu)
		for running {
			n, err := device.Read(buf, 0)
			if err != nil {
				if err == os.ErrClosed {
					log.Println("[tun2socks] device closed") // exact message not recovered
					return
				}
				log.Printf("[tun2socks][device.Read] %v", err)
				return
			}

			if n > mtu {
				continue
			}

			upLock.Lock()
			up += uint64(n)
			upLock.Unlock()

			if v := buf[0] >> 4; v != 4 && v != 6 {
				continue
			}

			if _, err := stack.Write(buf[:n]); err != nil {
				log.Printf("[tun2socks][lwip.Write] %v", err)
			}
		}
	}()

	return true
}

//export tun_free
func tun_free() C.bool { // main.go:227
	running = false

	if stack != nil {
		stack.Close()
	}
	if device != nil {
		device.Close()
	}

	stack, device, ranger = nil, nil, nil
	tcpHandler, udpHandler = nil, nil

	return true
}

//export tun_luid
func tun_luid() C.ulonglong { // only the cgo wrapper decompiled; by the imports it is the wintun adapter LUID
	return C.ulonglong(device.(*tun.NativeTun).LUID())
}

//export tun_getUP
func tun_getUP() C.ulonglong { // main.go:257
	upLock.Lock()
	defer upLock.Unlock()
	return C.ulonglong(up)
}

//export tun_getDL
func tun_getDL() C.ulonglong {
	dlLock.Lock()
	defer dlLock.Unlock()
	return C.ulonglong(dl)
}

func newRanger() bool { // main.go:272
	if bypassList == "disabled" {
		ranger = nil
		return true
	}

	f, err := os.OpenFile(bypassList, os.O_RDONLY, 0)
	if err != nil {
		log.Printf("[tun2socks][newRanger][os.Open] %v", err)
		return false
	}
	defer f.Close()

	ranger = cidranger.NewPCTrieRanger()

	sc := bufio.NewScanner(f)
	sc.Buffer(nil, 0x10000)
	for sc.Scan() {
		_, cidr, err := net.ParseCIDR(strings.TrimSpace(sc.Text()))
		if err != nil {
			log.Printf("[tun2socks][newRanger][net.ParseCIDR] %v", err)
			continue
		}

		if err := ranger.Insert(cidranger.NewBasicRangerEntry(*cidr)); err != nil {
			log.Printf("[tun2socks][newRanger][ranger.Insert] %v", err)
		}
	}

	return true
}

